{
    "schema": "agents.registry/v1",
    "agents": [
        {
            "id": "dependency-deployment",
            "class": "Workspace\\Agents\\Agents\\DependencyDeployment\\DependencyDeploymentAgent",
            "enabled": true,
            "subscriptions": [
                {
                    "topic": "release.requested",
                    "task": "deployment.readiness"
                }
            ]
        },
        {
            "id": "sentinel-verifier",
            "class": "Workspace\\Agents\\Agents\\SentinelVerifier\\SentinelVerifierAgent",
            "enabled": true,
            "subscriptions": [
                {
                    "topic": "deployment.completed",
                    "task": "sentinel.verify"
                },
                {
                    "topic": "sentinel.audit-requested",
                    "task": "sentinel.verify"
                }
            ],
            "produces": {
                "artifacts": [
                    "sentinel"
                ],
                "events": [
                    "sentinel.verification.passed",
                    "sentinel.verification.failed"
                ]
            }
        },
        {
            "id": "sentinel-ui-verifier",
            "class": "Workspace\\Agents\\Agents\\SentinelUiVerifier\\SentinelUiVerifierAgent",
            "enabled": true,
            "subscriptions": [
                {
                    "topic": "sentinel.verification.passed",
                    "task": "sentinel.ui-audit"
                },
                {
                    "topic": "sentinel.ui-audit-requested",
                    "task": "sentinel.ui-audit"
                }
            ],
            "produces": {
                "artifacts": [
                    "sentinel-ui"
                ],
                "events": [
                    "sentinel.ui-audit.passed",
                    "sentinel.ui-audit.failed"
                ]
            }
        },
        {
            "id": "server-disk-janitor",
            "class": "Workspace\\Agents\\Agents\\ServerDiskJanitor\\ServerDiskJanitorAgent",
            "enabled": true,
            "subscriptions": [
                {
                    "topic": "maintenance.disk-clean-requested",
                    "task": "disk.clean"
                },
                {
                    "topic": "deployment.completed",
                    "task": "disk.clean"
                },
                {
                    "topic": "maintenance.backup-archive-requested",
                    "task": "backup.archive"
                }
            ],
            "produces": {
                "artifacts": [
                    "disk-janitor",
                    "backup-archive"
                ],
                "events": [
                    "disk.cleanup.reported",
                    "backup.archive.reported"
                ]
            },
            "defaults": {
                "disk.clean": {
                    "dry_run": true
                },
                "backup.archive": {
                    "dry_run": true
                }
            }
        }
    ],
    "dashboard": {
        "schema": "agent-dashboard.layout/v1",
        "positions": {
            "dependency-deployment": {
                "x": 34,
                "y": 30
            },
            "release-preparer": {
                "x": 380,
                "y": 210
            },
            "sentinel-verifier": {
                "x": 719,
                "y": 37
            },
            "sentinel-ui-verifier": {
                "x": 1060,
                "y": 37
            },
            "server-disk-janitor": {
                "x": 719,
                "y": 330
            }
        },
        "edges": [
            {
                "source": "dependency-deployment",
                "target": "release-preparer",
                "label": null
            },
            {
                "source": "release-preparer",
                "target": "sentinel-verifier",
                "label": "deployment.completed"
            },
            {
                "source": "release-preparer",
                "target": "server-disk-janitor",
                "label": "deployment.completed"
            },
            {
                "source": "sentinel-verifier",
                "target": "sentinel-ui-verifier",
                "label": "sentinel.verification.passed"
            }
        ],
        "tasks": {
            "server-disk-janitor": [
                "disk.clean",
                "backup.archive"
            ]
        }
    }
}
